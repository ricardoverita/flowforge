# Docker Compose works without an .env file. These optional settings tune the demo.
API_PORT=8080
POSTGRES_PORT=5432
NATS_PORT=4222
WEB_PORT=3000
WORKER_DELAY=200ms
WORKER_FAIL_TASK=
WORKER_FAIL_ATTEMPTS=0

# For processes started directly on the host, supply credentials outside Git:
# DATABASE_URL=postgres://flowforge:<generated-password>@127.0.0.1:5432/flowforge?sslmode=disable
# NATS_URL=nats://127.0.0.1:4222
# NATS_TOKEN=<generated-token>
# API_TOKEN=<private-api-token>
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
